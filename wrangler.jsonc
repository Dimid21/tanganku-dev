{
  "name": "tanganku_site",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "vars": {
    "ADMIN_PASSWORD": "12345"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tg_dev1",
      "database_id": "Replace me with your actual database ID"
    }
  ],

  // --- R2 bucket binding for uploads ---
  // The code will use platform.env.ASSETS (same name in all envs)
  "r2_buckets": [
    {
      "binding": "R2_ASSETS",
      // Production bucket name in R2
      "bucket_name": "editable-website-assets",
      // Preview/`wrangler pages dev` bucket
      "preview_bucket_name": "editable-website-assets-dev"
    }
  ]
}
